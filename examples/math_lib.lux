// A math utility module
mod math_lib

fn square(x: Int) -> Int {
    x * x
}

fn cube(x: Int) -> Int {
    x * x * x
}

fn factorial(n: Int) -> Int {
    if n <= 1 {
        1
    } else {
        n * factorial(n - 1)
    }
}

fn main() -> () {
    print(square(5))
    print(cube(3))
    print(factorial(5))
}
